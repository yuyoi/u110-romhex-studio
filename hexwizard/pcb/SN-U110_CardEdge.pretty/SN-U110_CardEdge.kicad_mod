(footprint "SN-U110_CardEdge" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Roland SN-U110 / U-110 / U-220 / D-70 ROM card edge: 34 gold fingers, 1.5 mm pitch, single sided. Own drawing from measured geometry. Origin = pad 1 centre in X, card insertion edge at Y=0. Pad 32 (GND) is the long first-mate finger. VERIFY pin 1 side and pad order against a real card before ordering boards.")
